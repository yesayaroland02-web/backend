generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Todo {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    String?
  completed   Boolean   @default(false)

  category_id Int?
  category    Category? @relation(fields: [category_id], references: [id])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String

  todos Todo[]
}
